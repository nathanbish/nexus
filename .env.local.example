# ── Anthropic ──────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-your-key-here

# ── NextAuth ────────────────────────────────────────────────
NEXTAUTH_SECRET=generate-with-openssl-rand-base64-32
NEXTAUTH_URL=http://localhost:3000

# ── Google / Gmail ──────────────────────────────────────────
# Create at console.cloud.google.com → APIs & Services → Credentials
# Enable: Gmail API, Google Calendar API
# OAuth scopes: gmail.readonly, gmail.send, calendar.events
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ── Microsoft / Outlook ─────────────────────────────────────
# Create at portal.azure.com → App registrations
# Permissions: Mail.Read, Mail.Send, Calendars.ReadWrite
MICROSOFT_CLIENT_ID=your-azure-app-client-id
MICROSOFT_CLIENT_SECRET=your-azure-app-client-secret
MICROSOFT_TENANT_ID=common

# ── Second Outlook account (optional) ───────────────────────
# Uses the same Azure app — users sign in separately via OAuth
# No extra credentials needed; handled by NextAuth provider

# ── Production (Vercel) ─────────────────────────────────────
# Set NEXTAUTH_URL to your Vercel domain, e.g.:
# NEXTAUTH_URL=https://nexus.yourdomain.com
